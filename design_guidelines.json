      "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1ODF8MHwxfHNlYXJjaHwxfHxwcm9mZXNzaW9uYWwlMjBhdmF0YXIlMjBoZWFkc2hvdHxlbnwwfHx8fDE3Nzg5MjkxNTZ8MA&ixlib=rb-4.1.0&q=85"
    ],
    "backgrounds": [
      "https://images.unsplash.com/photo-1648878136531-15e7d3a88e76?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1NDh8MHwxfHNlYXJjaHwyfHxhYnN0cmFjdCUyMGdyZWVuJTIwd2F2ZXMlMjBiYWNrZ3JvdW5kfGVufDB8fHx8MTc3ODkyOTE1Nnww&ixlib=rb-4.1.0&q=85",
      "https://images.unsplash.com/photo-1618898613684-2cf0ae9a7c19?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1NDh8MHwxfHNlYXJjaHwxfHxhYnN0cmFjdCUyMGdyZWVuJTIwd2F2ZXMlMjBiYWNrZ3JvdW5kfGVufDB8fHx8MTc3ODkyOTE1Nnww&ixlib=rb-4.1.0&q=85"
    ],
    "logos": [
      "https://images.unsplash.com/photo-1661949734732-7a845100959e?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODd8MHwxfHNlYXJjaHwyfHxhYnN0cmFjdCUyMGdlb21ldHJpYyUyMGxvZ28lMjBncmVlbnxlbnwwfHx8fDE3Nzg5MjkxNTZ8MA&ixlib=rb-4.1.0&q=85"
    ]
  },
  "instructions_to_main_agent": [
    "Use tailwindcss for styling, overriding default config where needed (e.g., colors.primary: #10B981, font: Inter).",
    "Cards MUST have 28px border radius, 24px padding, and soft 10px 40px rgba(15,23,42,0.06) shadow.",
    "Add 'data-testid' attribute to all interactive and key informational elements.",
    "Buttons should have 14px border radius and 48px height.",
    "Ensure layout uses CSS Grid with 24px gap.",
    "Include Lucide React icons for the Dashboard (TrendingUp, Wallet, PiggyBank).",
    "Hero card should use the linear-gradient (#BBF7D0 to #86EFAC).",
    "Donut charts must have 70% cutout and bar charts 12px radius.",
    "Use Framer Motion to apply fade-slide transitions for pages and smooth-lift (translateY -4px) on card hovers.",
    "Avoid generic or placeholder text; use real UI copy fitting for a premium fintech app."
  ]
}
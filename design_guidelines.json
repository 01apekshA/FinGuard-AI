{
  "theme": "light",
  "archetype": "Organic & Earthy / Enterprise SaaS",
  "colors": {
    "primary": "#10B981",
    "secondary": "#34D399",
    "accent": "#E8F7EE",
    "background": "#F7FAFC",
    "surface": "#FFFFFF",
    "text": {
      "primary": "#0F172A",
      "secondary": "#64748B"
    },
    "border": "#E2E8F0",
    "status": {
      "danger": "#EF4444",
      "warning": "#F59E0B",
      "success": "#10B981",
      "info": "#3B82F6"
    },
    "chart": {
      "income": "#10B981",
      "expense": "#EF4444",
      "savings": "#3B82F6",
      "investment": "#8B5CF6"
    }
  },
  "typography": {
    "fontFamily": "Inter, sans-serif",
    "headings": {
      "weight": "700",
      "large": "34px",
      "medium": "24px",
      "small": "20px"
    },
    "body": {
      "weight": "500",
      "base": "16px",
      "small": "14px",
      "xs": "12px"
    }
  },
  "layout": {
    "sidebar": {
      "width": "260px",
      "behavior": "fixed"
    },
    "topbar": {
      "height": "80px"
    },
    "content": {
      "padding": "32px",
      "gap": "24px",
      "background": "#F7FAFC"
    }
  },
  "components": {
    "card": {
      "borderRadius": "28px",
      "shadow": "0 10px 40px rgba(15,23,42,0.06)",
      "padding": "24px",
      "hover": {
        "transform": "translateY(-4px)"
      },
      "background": "#FFFFFF",
      "border": "1px solid #E2E8F0"
    },
    "button": {
      "primary": {
        "background": "#10B981",
        "color": "#FFFFFF",
        "borderRadius": "14px",
        "height": "48px",
        "fontWeight": "600"
      },
      "secondary": {
        "background": "#ECFDF5",
        "color": "#10B981",
        "borderRadius": "14px",
        "height": "48px",
        "fontWeight": "600"
      },
      "hover": {
        "transform": "scale(1.02)"
      }
    },
    "hero_balance_card": {
      "background": "linear-gradient(135deg, #BBF7D0 0%, #86EFAC 100%)",
      "balanceFontSize": "42px",
      "actions": ["Deposit", "Send"]
    },
    "stats_cards": {
      "income": {
        "iconBg": "#DCFCE7",
        "icon": "TrendingUp"
      },
      "expense": {
        "iconBg": "#ECFCCB",
        "icon": "Wallet"
      },
      "savings": {
        "iconBg": "#D1FAE5",
        "icon": "PiggyBank"
      }
    }
  },
  "charts": {
    "line": {
      "thickness": 4,
      "tension": 0.4
    },
    "bar": {
      "borderRadius": 12
    },
    "donut": {
      "cutout": "70%"
    }
  },
  "animations": {
    "transitionDuration": "0.3s",
    "pageTransition": "fade-slide",
    "cardHover": "smooth-lift",
    "sidebarHighlight": "soft-highlight",
    "buttonHover": "scale-102"
  },
  "sections": {
    "dashboard": [
      "Balance hero card",
      "Cashflow Analytics (bar chart)",
      "AI Assistant chat widget",
      "Recent Transactions table",
      "Expense Statistics (donut chart cutout 70%)",
      "Currency Exchange widget",
      "Finance Score"
    ],
    "admin_panel": {
      "views": [
        "User management",
        "Fraud monitoring",
        "KYC approval",
        "Transaction monitoring",
        "Platform analytics",
        "Activity logs"
      ]
    },
    "wallet": [
      "Balance",
      "Send/Receive money",
      "Beneficiaries",
      "QR payment simulation",
      "Transaction History"
    ],
    "transactions": [
      "Search",
      "Filter",
      "Export",
      "Pagination",
      "Status tags"
    ],
    "ai_analytics": [
      "Spending Prediction",
      "Budget Recommendations",
      "Financial Health",
      "Risk Score",
      "Expense Categorization",
      "Fraud Alerts"
    ]
  },
  "design_rules": [
    "Generous whitespace",
    "Subtle animations",
    "Consistent border radius",
    "Light glassmorphism allowed",
    "Enterprise SaaS appearance",
    "No dark neon colors"
  ],
